# Copy to .env and fill in. Never commit .env — it is gitignored.
# Local values come from `supabase start` output.

# ── Server only (never exposed to a browser or app bundle) ──────────────────

# Pooled connection (Supavisor, transaction mode) — used by serverless functions.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct/session connection — used by drizzle-kit migrations. DDL needs session
# state that a transaction pooler will not hold, so this must NOT be the pooled URL.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

SUPABASE_URL=http://127.0.0.1:54321

# Bypasses RLS entirely. Server-side only, never in a client bundle, never logged.
SUPABASE_SERVICE_ROLE_KEY=

# JWKS endpoint for verifying access tokens locally instead of a network call
# to the auth server per request.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Base URL the webhook URLs handed to customers are built from. NOT derived from
# the request's host header — a proxied or spoofed host would produce a URL
# pointing somewhere else, and the owner would paste it in without knowing.
PUBLIC_APP_URL=http://127.0.0.1:5173

# ── Public by design (shipped to the client; anon key is safe with RLS on) ──

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
