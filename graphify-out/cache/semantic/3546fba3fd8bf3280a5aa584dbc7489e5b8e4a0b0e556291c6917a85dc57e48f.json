{"nodes": [{"id": "planning_seeds_full_auto_booking_seed", "label": "Seed: Full-Auto Booking Engine", "file_type": "document", "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L1-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planted 2026-08-23 as the graduated-autonomy end-state; triggered only after draft-and-approve ships and a lead category reaches ~90% approve-without-edit over 20-30 drafts for a given customer."}, {"id": "planning_seeds_full_auto_booking_unlock_criteria", "label": "Full-auto unlock criteria", "file_type": "concept", "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L12-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At least 20-30 drafts sent in a category with 90%+ approved without edits, and even then offered only as an explicit opt-in toggle ('Auto-answer new inquiries?') per category and per customer \u2014 so autonomy is never switched on without both evidence and consent."}, {"id": "planning_seeds_full_auto_booking_approval_rate_telemetry", "label": "Approval-rate telemetry as autonomy gate", "file_type": "concept", "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L3, L12-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approve-without-edit rate is the measurable proxy for whether drafts are trustworthy in a category, turning an otherwise subjective trust decision into a threshold."}, {"id": "planning_seeds_full_auto_booking_autonomy_guardrails", "label": "Always-on autonomy guardrails", "file_type": "concept", "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L15-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even in full-auto mode the system escalates pricing commitments, refunds/discounts, negative sentiment and low-confidence cases to a human, respects owner-defined quiet hours by queueing until morning, caps autonomous touches per lead (e.g. 2), and keeps per-category switches plus a global kill switch \u2014 the classes of mistake that would destroy trust are structurally removed from the model's reach."}, {"id": "planning_seeds_full_auto_booking_auto_booking_behavior", "label": "Full-auto booking behavior", "file_type": "concept", "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L21-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-reply within minutes of a new inquiry, propose slots from the connected calendar, confirm the booking, and send the owner a daily activity digest \u2014 speed is the value, and the digest preserves owner oversight without requiring per-message attention."}], "edges": [{"source": "planning_seeds_full_auto_booking_seed", "target": "planning_seeds_full_auto_booking_unlock_criteria", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L11-L14", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_seed", "target": "planning_seeds_full_auto_booking_autonomy_guardrails", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L15-L20", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_seed", "target": "planning_seeds_full_auto_booking_auto_booking_behavior", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L21-L25", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_approval_rate_telemetry", "target": "planning_seeds_full_auto_booking_unlock_criteria", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L3, L12-L13", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_unlock_criteria", "target": "planning_seeds_full_auto_booking_auto_booking_behavior", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L9-L25", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_autonomy_guardrails", "target": "planning_seeds_full_auto_booking_auto_booking_behavior", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L15-L25", "weight": 1.0}, {"source": "planning_seeds_full_auto_booking_seed", "target": "planning_notes_product_direction_auto_capture_draft_and_approve_follow_ups", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L3", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_draft_and_approve_follow_ups", "target": "planning_seeds_full_auto_booking_approval_rate_telemetry", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".planning/seeds/full-auto-booking.md", "source_location": "L3, L12-L13", "weight": 0.8}], "hyperedges": [{"id": "graduated_autonomy_ladder", "label": "Graduated autonomy ladder: notify, then draft-and-approve, then telemetry-gated full auto with guardrails", "nodes": ["planning_project_push_notifications", "planning_notes_product_direction_auto_capture_draft_and_approve_follow_ups", "planning_seeds_full_auto_booking_approval_rate_telemetry", "planning_seeds_full_auto_booking_unlock_criteria", "planning_seeds_full_auto_booking_autonomy_guardrails", "planning_seeds_full_auto_booking_auto_booking_behavior"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/seeds/full-auto-booking.md"}]}