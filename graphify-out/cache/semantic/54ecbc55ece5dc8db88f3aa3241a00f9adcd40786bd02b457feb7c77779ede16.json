{"nodes": [{"id": "planning_notes_product_direction_auto_capture_decision_record", "label": "Decision Record \u2014 Automated Lead Capture & Recovery", "file_type": "document", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L1-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exploration session following the v1 CSV-upload release, recording decisions on sources, access strategy, scope and autonomy posture (dated 2026-08-23)."}, {"id": "planning_notes_product_direction_auto_capture_manual_csv_friction", "label": "Problem: manual CSV export friction", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L9-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Around 90% of target customers are non-technical local business owners who will never gather or export lead data manually, so the product must observe leads automatically, report missed revenue proactively, and then recover those leads."}, {"id": "planning_notes_product_direction_auto_capture_broad_target_customer", "label": "Deliberately broad target customer", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L16-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local service businesses, CRM-using agencies/coaches and website owners are all in scope with no exclusive wedge segment: integration order substitutes for segmentation, so whichever source ships first implicitly selects the early customers."}, {"id": "planning_notes_product_direction_auto_capture_source_access_reality", "label": "Source access reality matrix", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L22-L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Researched 2026-08-23: CRMs expose open OAuth APIs (low friction), forms/Calendly/Typeform expose webhooks (trivial), Gmail/Outlook are gated by Google verification (weeks), IG/FB DMs need professional accounts plus Meta App Review (hard), and personal WhatsApp has no official API at all (blocked). This friction ranking, not customer preference, sets the build order."}, {"id": "planning_notes_product_direction_auto_capture_integration_order", "label": "Integration order (four phases)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L32-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 webhooks plus email forwarding, Phase 2 CRM OAuth, Phase 3 Gmail read-only OAuth as a convenience upgrade, Phase 4 the Meta stack. Ordering by approval friction means shipping value before depending on any third-party reviewer."}, {"id": "planning_notes_product_direction_auto_capture_webhook_ingestion", "label": "Webhook ingestion (unique URL per customer)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works day one with zero platform approvals: the customer pastes a URL into an existing form or scheduling tool, which is the lowest-friction path to automatic capture."}, {"id": "planning_notes_product_direction_auto_capture_email_forwarding_ingestion", "label": "Email-forwarding ingestion (@in.missedlead.app inbox)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A unique inbound inbox via Cloudflare Email Routing or Postmark captures leads from tools that only send email notifications, again without any OAuth verification process."}, {"id": "planning_notes_product_direction_auto_capture_crm_oauth_connectors", "label": "CRM OAuth connectors (HubSpot/Zoho/GHL)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L26, L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_notes_product_direction_auto_capture_gmail_oauth_read_only", "label": "Gmail read-only OAuth", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L28, L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treated as a convenience upgrade rather than a foundation because Google verification takes weeks and would block launch if depended on."}, {"id": "planning_notes_product_direction_auto_capture_meta_stack_integration", "label": "Meta stack (Instagram/Facebook DMs)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L29, L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last in order: only professional accounts are readable and Meta App Review gates access, so effort here is high-risk relative to the leads it unlocks."}, {"id": "planning_notes_product_direction_auto_capture_personal_whatsapp_blocked", "label": "Personal WhatsApp is blocked (no official API)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L30, L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No official API exists; coverage is only possible through a Business Platform migration, so personal WhatsApp is excluded rather than half-supported."}, {"id": "planning_notes_product_direction_auto_capture_architecture_consequences", "label": "Accepted architecture consequences", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L41-L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic capture forces a real backend for webhook receivers and token storage (serverless on Vercel is acceptable), a multi-tenant database with per-customer isolation, and push notifications on both Expo and PWA \u2014 the current static PWA plus Expo app cannot host integrations at all."}, {"id": "planning_notes_product_direction_auto_capture_draft_and_approve_follow_ups", "label": "Draft-and-approve follow-ups (one-tap send)", "file_type": "concept", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L53-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The middle rung of the autonomy ladder: the system writes the message and the owner sends it with one tap, which both saves time and generates the approve/edit telemetry that later justifies full autonomy."}, {"id": "planning_notes_product_direction_auto_capture_graduated_autonomy_posture", "label": "Autonomy posture rationale (graduated)", "file_type": "rationale", "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L51-L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-auto on day one destroys trust on the first mistake; approve-only forever fails busy owners and defeats the product promise. The graduated ladder \u2014 detect and notify, then draft and approve, then per-customer per-category full-auto after ~90% approve-without-edit over 20-30 drafts, always with escalation rules, quiet hours and toggles \u2014 earns autonomy from measured telemetry."}], "edges": [{"source": "planning_notes_product_direction_auto_capture_decision_record", "target": "planning_notes_product_direction_auto_capture_manual_csv_friction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L9-L14", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_decision_record", "target": "planning_notes_product_direction_auto_capture_broad_target_customer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L16-L20", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_decision_record", "target": "planning_notes_product_direction_auto_capture_source_access_reality", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L22-L30", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_manual_csv_friction", "target": "planning_project_zero_effort_data_capture", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L9-L14", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_source_access_reality", "target": "planning_notes_product_direction_auto_capture_integration_order", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L22-L39", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_source_access_reality", "target": "planning_notes_product_direction_auto_capture_personal_whatsapp_blocked", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L30", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_integration_order", "target": "planning_notes_product_direction_auto_capture_webhook_ingestion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_integration_order", "target": "planning_notes_product_direction_auto_capture_email_forwarding_ingestion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_integration_order", "target": "planning_notes_product_direction_auto_capture_crm_oauth_connectors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L37", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_integration_order", "target": "planning_notes_product_direction_auto_capture_gmail_oauth_read_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L38", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_integration_order", "target": "planning_notes_product_direction_auto_capture_meta_stack_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L39", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_broad_target_customer", "target": "planning_notes_product_direction_auto_capture_integration_order", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L19-L20", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_architecture_consequences", "target": "planning_project_backend_jump_accepted", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L41-L50", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_architecture_consequences", "target": "planning_project_multi_tenant_postgres_on_supabase", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L45", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_architecture_consequences", "target": "planning_project_push_notifications", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L46", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_architecture_consequences", "target": "planning_project_normalized_lead_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L47-L50", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_architecture_consequences", "target": "readme_browser_local_processing", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L43-L44", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_graduated_autonomy_posture", "target": "planning_notes_product_direction_auto_capture_draft_and_approve_follow_ups", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L51-L61", "weight": 1.0}, {"source": "planning_notes_product_direction_auto_capture_graduated_autonomy_posture", "target": "planning_project_graduated_autonomy", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L51-L61", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_graduated_autonomy_posture", "target": "planning_seeds_full_auto_booking_seed", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L55-L57", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_webhook_ingestion", "target": "planning_project_webhook_idempotency", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "weight": 0.8}, {"source": "planning_notes_product_direction_auto_capture_email_forwarding_ingestion", "target": "planning_state_phase_2_webhook_ingest", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": ".planning/notes/product-direction-auto-capture.md", "source_location": "L34-L36", "weight": 0.4}], "hyperedges": [{"id": "ingestion_convergence_pipeline", "label": "All ingestion sources converge on one normalized Lead schema feeding the core engine", "nodes": ["planning_notes_product_direction_auto_capture_webhook_ingestion", "planning_notes_product_direction_auto_capture_email_forwarding_ingestion", "planning_project_csv_upload_as_backfill", "planning_project_normalized_lead_schema", "planning_project_packages_core"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/notes/product-direction-auto-capture.md"}]}