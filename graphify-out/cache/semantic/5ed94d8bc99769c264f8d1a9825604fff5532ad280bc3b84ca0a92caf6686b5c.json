{"nodes": [{"id": "planning_state_project_state", "label": "Project State (v2.0 progress record)", "file_type": "document", "source_file": ".planning/STATE.md", "source_location": "L16-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_state_six_phase_milestone_structure", "label": "Six-phase v2.0 milestone structure", "file_type": "concept", "source_file": ".planning/STATE.md", "source_location": "L8-L13, L20-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v2.0 is decomposed into six phases tracked as 1 of 6 complete (17%), so an infrastructure-heavy milestone still reports discrete, verifiable increments rather than one long unbounded build."}, {"id": "planning_state_phase_1_multi_tenant_foundation", "label": "Phase 1 \u2014 Multi-tenant foundation (complete)", "file_type": "concept", "source_file": ".planning/STATE.md", "source_location": "L20-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delivered 7 tables with RLS enabled at creation time, 8 authenticated plus 6 ingest policies, 124 green tests across 9 files, and a JWT-to-customer resolver \u2014 deliberately with no UI, because tenant isolation had to be provable before anything was built on top of it."}, {"id": "planning_state_phase_2_webhook_ingest", "label": "Phase 2 \u2014 Webhook ingest (next)", "file_type": "concept", "source_file": ".planning/STATE.md", "source_location": "L52-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as the first user-visible value. Because the repository functions it needs already exist and are tested, Phase 2 reduces to the HTTP endpoint, token issuance and rotation, rate limiting, and the 'we're listening' test-connection UX."}, {"id": "planning_state_isolation_negative_control", "label": "Isolation negative control (test:prove-isolation)", "file_type": "concept", "sour