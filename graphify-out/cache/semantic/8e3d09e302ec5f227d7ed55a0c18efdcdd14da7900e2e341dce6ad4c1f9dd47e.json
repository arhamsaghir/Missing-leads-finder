{"nodes": [{"id": "readme_missed_lead_revenue_finder", "label": "README \u2014 Missed Lead Revenue Finder (v1)", "file_type": "document", "source_file": "README.md", "source_location": "L1-L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positions the tool as narrow and audit-first for local service businesses: it finds missed revenue rather than promising to fix it."}, {"id": "readme_csv_upload", "label": "CSV upload / paste flow", "file_type": "concept", "source_file": "README.md", "source_location": "L7-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_csv_format", "label": "CSV format with column aliases", "file_type": "concept", "source_file": "README.md", "source_location": "L25-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case-insensitive canonical columns with generous aliases, multiple date formats and currency-string parsing, plus unknown statuses degrading to 'new' with a warning \u2014 exports from arbitrary CRMs must load without the user editing the file."}, {"id": "readme_leak_detection_rules", "label": "Leak detection rules (four categories)", "file_type": "concept", "source_file": "README.md", "source_location": "L48-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lead may carry several leaks, but unique affected leads are counted once so overlapping rules cannot inflate the headline revenue figure."}, {"id": "readme_no_reply_leak", "label": "No reply leak", "file_type": "concept", "source_file": "README.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "last_contact_at blank and status not booked/lost/recovered/won."}, {"id": "readme_slow_reply_leak", "label": "Slow reply leak", "file_type": "concept", "source_file": "README.md", "source_location": "L53", "source_url": null, "