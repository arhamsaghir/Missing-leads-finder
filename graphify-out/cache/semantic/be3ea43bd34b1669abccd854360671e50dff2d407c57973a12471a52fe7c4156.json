{"nodes": [{"id": "planning_research_architecture_target_architecture_v2", "label": "Target Architecture (v2)", "file_type": "concept", "rationale": "Existing product is stateless (no backend, no DB); v2 adds a backend tier so lead capture can happen continuously instead of via manual CSV upload.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_existing_stateless_monorepo", "label": "Existing Stateless Monorepo (packages/core + packages/ui, Vite PWA, Expo 57)", "file_type": "concept", "rationale": "Monorepo with core engine and Tamagui UI kit, Vite PWA on Vercel, Expo 57 mobile; stateless with no backend or DB today, which is why every new component is additive.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_ingest_api", "label": "Ingest API (/api/hook/[token].ts, /api/inbound-email.ts)", "file_type": "concept", "rationale": "Single entry point that validates, normalizes, dedupes, persists and triggers detection per customer, so every source shares one funnel.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_db_layer", "label": "DB Layer (Drizzle schema: customers, lead_sources, leads, lead_events, detection_settings, push_tokens)", "file_type": "concept", "rationale": "Multi-tenant via customer_id FK on every row plus Postgres RLS so isolation is enforced at the database rather than in application code.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_detection_service", "label": "Detection Service (pure function in packages/core)", "file_type": "concept", "rationale": "Reuses existing rules and is invoked per-event plus by a nightly sweep; emits missed-lead rows with dollar estimates. Kept pure so it stays testable and reusable.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_notification_dispatcher", "label": "Notification Dispatcher (Expo push + web-push)", "file_type": "concept", "rationale": "Single dispatcher with a per-device token registry so mobile and PWA delivery share one send path.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_onboarding_ui", "label": "Onboarding UI (connection cards with live listening test)", "file_type": "concept", "rationale": "Live 'we're listening' test state proves the connection works without the owner needing technical help.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_auth", "label": "Auth (email OAuth sign-in + session to customer_id middleware)", "file_type": "concept", "rationale": "Email OAuth avoids passwords for non-technical owners; middleware resolves session to customer_id so tenancy is applied uniformly.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_neon_postgres_rls", "label": "Neon Postgres with RLS by customer_id", "file_type": "concept", "rationale": "Stores leads, events, customers, push_tokens and settings with row-level security keyed on customer_id.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_multi_tenant_customer_id", "label": "Multi-Tenancy via customer_id", "file_type": "concept", "rationale": "customer_id FK on every row is the single tenancy primitive, enforced by RLS instead of query-time filtering.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_lead_schema", "label": "Normalized Lead Schema", "file_type": "concept", "rationale": "All ingest paths normalize into the same Lead schema the CSV parser already emits, so the detection engine needs no rewrite.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_dedupe_hash_name_contact", "label": "Dedupe by Hash of Name + Contact", "file_type": "concept", "rationale": "Ingest-time dedupe key prevents the same person counting twice when they arrive through more than one pipe.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_nightly_cron_sweep", "label": "Nightly Cron Sweep", "file_type": "concept", "rationale": "Catches leads that aged past the response threshold, which event-driven detection alone cannot observe.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_missed_lead_records", "label": "Missed-Lead Records with Dollar Estimate", "file_type": "concept", "rationale": "Detection output is a persisted record carrying a revenue estimate, which is what makes notifications and the dashboard actionable.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_expo_push_mobile", "label": "Expo Push (mobile delivery)", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_web_push_pwa", "label": "Web Push (PWA delivery)", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_deep_link_to_lead_detail", "label": "Deep Link to Lead Detail Screen", "file_type": "concept", "rationale": "Both push channels converge on one deep link so a tap always lands on the actionable lead.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_cloudflare_email_worker", "label": "Cloudflare Email Worker (Gmail filter forward receiver)", "file_type": "concept", "rationale": "Gmail forwarding hits an Email Worker that POSTs into the same ingest API, avoiding a second pipeline.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_detection_as_library_event_stream", "label": "Detection Input Shifts from File-at-Rest to Event Stream", "file_type": "rationale", "rationale": "The engine becomes a library called by ingest and cron rather than an upload handler; this is the central data-flow change of v2.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_settings_move_to_db", "label": "Settings Move from Client State to DB", "file_type": "rationale", "rationale": "Thresholds must live server-side because they drive detection running in cron and on ingest, not just in the client session.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_csv_upload_backfill_path", "label": "CSV Upload Path as Historical Backfill", "file_type": "concept", "rationale": "CSV path persists unchanged but writes to the same leads table, flagged source:'csv', so history and stream never diverge.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_order", "label": "Suggested Build Order (dependency-driven)", "file_type": "rationale", "rationale": "Ordering is derived from dependencies rather than perceived value: tenancy underpins everything, then each ingest pipe, then detection, then delivery, then reporting polish.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_db_auth_skeleton", "label": "Build Step 1: DB + Auth + Multi-Tenant Skeleton", "file_type": "concept", "rationale": "First because everything downstream needs tenancy.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_ingest_webhook", "label": "Build Step 2: Ingest Webhook Endpoint + Test-Connection UX", "file_type": "concept", "rationale": "Chosen as step 2 because it is the first user-visible value.", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_email_inbound_worker", "label": "Build Step 3: Email Inbound Worker into Same Pipeline", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_detection_on_event", "label": "Build Step 4: Detection-on-Event + Nightly Sweep", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_push_notifications", "label": "Build Step 5: Push Notifications (mobile then PWA) + Content", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_architecture_build_step_dashboard_upgrade", "label": "Build Step 6: Dashboard Upgrade + Settings Screens", "file_type": "concept", "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "planning_research_architecture_ingest_api", "target": "planning_research_architecture_target_architecture_v2", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/ARCHITECTURE.md", "source_location": null, "weight": 1.0}, {"source": "planning_research_architecture_db_layer", "target": "planning_research_architecture_target_architecture_v2", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/ARCHITECTURE