{"nodes": [{"id": "planning_research_pitfalls_webhook_ingestion_pitfalls", "label": "Webhook Ingestion Pitfalls", "file_type": "concept", "rationale": "Category covering spam to hook URLs, duplicate POSTs and silent secret-rotation breakage; all land in the ingest phase.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_email_ingestion_pitfalls", "label": "Email Ingestion Pitfalls", "file_type": "concept", "rationale": "Category covering mail loops, spam floods and encoding mangling; all land in the email-inbound phase.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_serverless_database_pitfalls", "label": "Serverless + Database Pitfalls", "file_type": "concept", "rationale": "Category covering pool exhaustion and forgotten RLS; both are foundation-phase decisions that are expensive to retrofit.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_push_notification_pitfalls", "label": "Push Notification Pitfalls", "file_type": "concept", "rationale": "Category covering cold permission asks and token rot.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_data_correctness_pitfalls", "label": "Data Correctness Pitfalls", "file_type": "concept", "rationale": "Category covering double-counted revenue and CSV-vs-stream drift; both are ultimately schema-design problems.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_compliance_lite_pitfalls", "label": "Compliance-Lite Pitfalls", "file_type": "concept", "rationale": "Category covering unbounded PII retention; treated as a pre-launch checklist rather than early work.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_unauthenticated_spam_to_hook_urls", "label": "Pitfall 1: Unauthenticated Spam to Hook URLs", "file_type": "concept", "rationale": "Bots scan /hook/* paths. Warning sign: junk leads appearing. Prevention: high-entropy secret in the URL path, reject unknown tokens silently, rate-limit per IP. Phase 2 (ingest).", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_duplicate_posts", "label": "Pitfall 2: Duplicate POSTs", "file_type": "concept", "rationale": "Typeform retries on timeout and Calendly redelivers. Prevention: idempotency key = hash of payload identity fields, upsert never blind insert, respond 200 in under 200ms and process async if slow. Phase 2.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_silent_secret_rotation_breakage", "label": "Pitfall 3: Secret Rotation Breaks Customer's Form Silently", "file_type": "concept", "rationale": "Warning sign: incoming requests to a dead token. Prevention: accept old and new secret during an overlap window and alert on hits to dead tokens. Phase 2.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_mail_loop", "label": "Pitfall 4: Mail Loop", "file_type": "concept", "rationale": "Our own notification email gets forwarded back into the inbound address. Prevention: skip messages whose from contains our domain, add an X-MissedLead header and drop echoes. Phase 3.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_spam_flood_pollutes_revenue_estimates", "label": "Pitfall 5: Spam Floods Inbox and Junk Leads Pollute Revenue Estimates", "file_type": "concept", "rationale": "Prevention: lightweight spam scoring before LLM extraction plus an auto-quarantine folder visible in the UI. Phase 3.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_html_quoted_printable_mangling", "label": "Pitfall 6: HTML/Quoted-Printable Mangling Produces Garbage Contact Fields", "file_type": "concept", "rationale": "Prevention: let mailparser handle encodings, never regex raw bodies, use LLM extraction only for the free-text intent field with schema-validated output, and flag low-confidence results rather than guessing. Phase 3.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_connection_pool_exhaustion", "label": "Pitfall 7: Connection Pool Exhaustion", "file_type": "concept", "rationale": "Every serverless invocation opens a Postgres connection and ~50 concurrent hits kill the DB. Warning sign: intermittent 'too many connections' at low traffic. Prevention: Neon HTTP serverless driver from day one, not node-postgres pooling. Phase 1 \u2014 a foundation decision that is expensive to retrofit.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_rls_forgotten_tenant_data_leak", "label": "Pitfall 8: RLS Forgotten and Tenant Data Leaks Across Accounts", "file_type": "concept", "rationale": "Prevention: enable RLS on ALL tables at migration time and add an integration test proving customer A cannot read customer B's leads. Phase 1.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_cold_permission_ask_permanent_denial", "label": "Pitfall 9: Permission Asked Cold at First Launch Causes Permanent Denial", "file_type": "concept", "rationale": "Prevention: ask after the first value moment (the first ingested lead) with a pre-permission explainer. Phase 5.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_push_token_rot", "label": "Pitfall 10: Push Token Rot", "file_type": "concept", "rationale": "Uninstalled apps keep dead tokens and sends fail silently. Prevention: prune on expired/invalid responses and track last-seen. Phase 5.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_double_counted_lost_revenue", "label": "Pitfall 11: Double-Counted Lost Revenue", "file_type": "concept", "rationale": "Same lead arrives via form AND forwarded email. Prevention: dedupe key on normalized phone/email plus fuzzy name, merging sources onto one lead record. Sits on the Phase 2/3 boundary, so the key must be designed into the schema in Phase 1 with enforcement from Phase 2 onward.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_csv_vs_streamed_data_drift", "label": "Pitfall 12: CSV-Era Data vs Streamed Data Drift", "file_type": "concept", "rationale": "Different null semantics and timestamps between the two paths. Prevention: one table from day one, with CSV backfill writing through the same normalizer. Phase 2.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_unbounded_pii_retention", "label": "Pitfall 13: End-Customer PII Stored Without Bounds", "file_type": "concept", "rationale": "Prevention: a retention policy field (e.g. purge lead PII after 12 months), delete-account cascade, and a privacy policy page before public launch. Phase 6 pre-launch checklist.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_high_entropy_url_secret", "label": "Prevention: High-Entropy Secret in Hook URL Path", "file_type": "concept", "rationale": "Unknown tokens are rejected silently and requests are rate-limited per IP, so scanners get no signal that a path exists.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_idempotency_key_hash", "label": "Prevention: Idempotency Key = Hash of Payload Identity Fields", "file_type": "concept", "rationale": "Upsert rather than blind insert, and respond 200 within 200ms so senders do not retry in the first place.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_secret_overlap_window", "label": "Prevention: Accept Old and New Secret During Overlap Window", "file_type": "concept", "rationale": "Rotation becomes non-breaking, and traffic to a dead token raises an alert instead of vanishing.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_x_missedlead_echo_header", "label": "Prevention: X-MissedLead Header and Own-Domain Sender Skip", "file_type": "concept", "rationale": "Two independent guards (header marker plus from-domain check) stop our own notifications re-entering the pipeline.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_lightweight_spam_scoring_quarantine", "label": "Prevention: Lightweight Spam Scoring + Visible Quarantine", "file_type": "concept", "rationale": "Scoring runs before LLM extraction to save cost, and quarantine is visible in the UI so real leads are never lost silently.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_schema_validated_llm_extraction", "label": "Prevention: Schema-Validated LLM Extraction, Flag Instead of Guess", "file_type": "concept", "rationale": "LLM is confined to the free-text intent field with validated output; low confidence flags for review rather than fabricating a value.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_neon_http_driver_from_day_one", "label": "Prevention: Neon HTTP Serverless Driver from Day One", "file_type": "concept", "rationale": "Adopted at foundation time specifically because swapping the data-access layer later is expensive.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_rls_at_migration_time_with_cross_tenant_test", "label": "Prevention: RLS on All Tables at Migration Time + Cross-Tenant Test", "file_type": "concept", "rationale": "Enabling RLS during migration makes it the default state, and the integration test turns tenant isolation into a regression-checked property.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_ask_after_first_value_moment", "label": "Prevention: Ask for Push Permission After First Value Moment", "file_type": "concept", "rationale": "A pre-permission explainer shown after the first ingested lead trades a small delay for a much higher opt-in rate, and denial is effectively permanent.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_token_pruning_last_seen", "label": "Prevention: Prune Tokens on Expired/Invalid + Last-Seen Tracking", "file_type": "concept", "rationale": "Turns silent send failures into observable token lifecycle state.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_dedupe_key_normalized_contact_fuzzy_name", "label": "Prevention: Dedupe Key on Normalized Phone/Email + Fuzzy Name", "file_type": "concept", "rationale": "Merges multiple sources onto one lead record; must exist in the schema from day one because retrofitting it corrupts historical revenue figures.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_single_leads_table_shared_normalizer", "label": "Prevention: One Leads Table with a Shared Normalizer", "file_type": "concept", "rationale": "CSV backfill writes through the same normalizer as the stream, so null semantics and timestamps cannot drift apart.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_research_pitfalls_pii_retention_policy_and_cascade_delete", "label": "Prevention: Retention Policy Field, Delete-Account Cascade, Privacy Policy", "file_type": "concept", "rationale": "Bounds PII exposure (e.g. purge after 12 months) and is gated as a pre-public-launch requirement.", "source_file": ".planning/research/PITFALLS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "planning_research_pitfalls_neon_http_driver_from_day_one", "target": "planning_research_stack_neon_serverless_driver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "planning_research_pitfalls_schema_validated_llm_extraction", "target": "planning_research_stack_mailparser_llm_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "planning_research_pitfalls_html_quoted_printable_mangling", "target": "planning_research_stack_mailparser_llm_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"source": "planning_research_pitfalls_rls_forgotten_tenant_data_leak", "target": "planning_research_stack_postgres_rls_tenant_isolation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".planning/research/PITFALLS.md", "source_location": null, "weight": 1.0}, {"so